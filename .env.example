# Copia questo file in ".env" e adatta i valori se necessario
# node -e "" non serve: basta "cp .env.example .env"

PORT=3000

# Endpoint compatibile OpenAI esposto da Ollama
OPENAI_BASE_URL=http://localhost:11434/v1

# Ollama non verifica davvero questa chiave, ma il client OpenAI la richiede comunque
OPENAI_API_KEY=ollama
